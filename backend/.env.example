# Copy this file to backend/.env and replace the API key placeholder.
# The application reads backend/.env regardless of the working directory.

# Required for POST /v1/chat, GET /test, and GET /v1/health/GROQ.
GROQ_API_KEY=replace-with-your-groq-api-key
# Used by both the chat agent and the Groq connection check.
GROQ_MODEL_NAME=openai/gpt-oss-120b

# Redis connection used by GET /test.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=replace-with-your-redis-password

# Optional: only needed for the legacy /v1/health/CODE_CRAFT endpoints.
# OPENAI_API_KEY=replace-with-your-codecraft-api-key

# Optional application settings.
APP_NAME="My FastAPI Application"
APP_VERSION=1.0.0

# Optional SQLite checkpoint location for persistent conversation history.
# Omit this to use backend/checkpoints.sqlite, resolved by the application.
# Relative overrides resolve from the process working directory.
# CHECKPOINT_DB=/absolute/path/to/checkpoints.sqlite
