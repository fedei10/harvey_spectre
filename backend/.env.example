# Copy to backend/.env. Do not commit credentials.
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL_NAME=openai/gpt-oss-120b
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=replace-with-your-redis-password
APP_NAME="My FastAPI Application"
APP_VERSION=1.0.0

# Existing cloud PostgreSQL settings
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=your-postgres-db

# Preferred: dedicated full direct connection URL for LangGraph checkpoints.
# Use a PostgreSQL URL with SSL (and URL-encoded special password characters).
# LANGGRAPH_DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require
# If omitted, fallback to DATABASE_URL, then POSTGRES_* above.
# DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require
POSTGRES_SSLMODE=require
LANGGRAPH_POOL_MIN_SIZE=1
LANGGRAPH_POOL_MAX_SIZE=5
