# Secrets (also protected by the repository-level ignore rules).
.env
.env.*
!.env.example
!.env.*.example

# Python virtual environments and bytecode.
venv/
.venv/
env/
__pycache__/
*.py[cod]

# Test, coverage, type-checker, and linter caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Python packaging output.
build/
dist/
*.egg-info/
.eggs/

# Local conversation databases and SQLite sidecar files.
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
checkpoints.db
checkpoints.db-*
